{
  "name": "fakemyride",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3000",
    "dev:clean": "node scripts/dev-clean.js",
    "kill-port": "for /f \"tokens=5\" %a in ('netstat -ano | findstr :3000') do taskkill /PID %a /F 2>nul || echo Port 3000 is free",
    "build": "next build",
    "build:analyze": "ANALYZE=true npm run build",
    "build:prod": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "size-check": "npm run build && npx bundlesize",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "clean": "rm -rf .next out",
    "export": "next export",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:init": "npm run db:push && npm run db:seed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GordanVasilic/FakeMyRide.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/GordanVasilic/FakeMyRide/issues"
  },
  "homepage": "https://github.com/GordanVasilic/FakeMyRide#readme",
  "description": "",
